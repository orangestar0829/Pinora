{
  "name": "pinora",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts *.json *.ts *.js index.html public/manifest.json",
    "package:extension": "npm run build && powershell -NoProfile -File scripts/package.ps1",
    "package:firefox": "npm run build && powershell -NoProfile -File scripts/package.ps1 -Firefox",
    "package:submission": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-submission.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.320",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vitest": "4.1.11"
  }
}
